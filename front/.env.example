# ---------------------------------------------------------------------------
# Frontend environment
#
# Copy to `front/.env.local` for local work. Next.js only reads NEXT_PUBLIC_*
# from the client bundle, so every value here ships to the browser and must be
# treated as public. Never put a secret in this file.
#
# The frontend never talks to PostgreSQL, Redis or MinIO directly. Those live on
# the VPS behind the tunnel; only the API hostname below is public.
# ---------------------------------------------------------------------------

# Base URL of the backend API.
#
# Local development: run the API on the same machine and point at it directly.
# Use `localhost`, NOT `127.0.0.1`:
#   NEXT_PUBLIC_API_URL=http://localhost:4000
#
# A page on `localhost:3000` and an API on `127.0.0.1:4000` are different *sites*
# to a browser, not one host on two ports. The session cookie is SameSite=Lax,
# and Lax only rides along on a cross-origin fetch when both are the same site,
# so the cookie is dropped on every call and sign-in appears to do nothing. Keep
# the hostname identical on both sides.
#
# Production: the cloudflared hostname, over HTTPS. This must be an exact
# match for an entry in the backend's CORS_ORIGINS, or the browser blocks the
# request before it is sent.
#   NEXT_PUBLIC_API_URL=https://api.your-domain.com
#
# Subdomains of one domain (app.example.com + api.example.com) are same-site and
# work with COOKIE_SAME_SITE=lax. Two unrelated domains are not: set
# COOKIE_SAME_SITE="none" on the backend, which also requires HTTPS.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cookie policy is configured on the backend, not here: set COOKIE_SAME_SITE in
# back/.env to match. If sessions appear to log out at random, the frontend
# origin and the API origin are not same-site and the backend needs
# COOKIE_SAME_SITE="none". The frontend sends credentials either way; it reads
# no cookie policy variable.
