# aku pake graphify kang
graphify-out

# Secrets. `.env` and the concrete production file are ignored; `.env.example`
# files are config documentation and are meant to be committed.
.env
.env.local
.env.*.local
.env.production
.env.production.local

node_modules

#why? this worked by multiple people, so it wont clash with the .md files that are already in the repo. the only truly useful .md are in the folder of each service.
#DONT you dare to disobey this, im in control.
.opencode
*.md
!CONNECTION.md
!README.md
.vscode


# Compiled output sitting next to the sources shadows the .ts files at runtime.
# These are build artefacts; the TypeScript originals are the source of truth.
back/src/**/*.js
back/drizzle.config.js

# pm2 writes process logs here
back/logs/

# Database snapshots from scripts/db-backup.ts. These are full row dumps and
# contain real user emails, so they must never be committed.
back/backups/

# Vendored agent tooling, not project source
back/.agents/
back/skills-lock.json
back/.neon

# Artifacts of editing files on the /mnt/windows FUSE mount. They are not source.
.fuse_hidden*
