    "db:migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@types/bun": "^1.4.2",
    "bullmq": "^6.3.9",
    "drizzle-orm": "^0.45.3",
    "elysia": "latest",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
