{
  "name": "back",
  "version": "1.0.50",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test __tests__/lib/",
    "test:api": "bun test __tests__/api/",
    "dev": "bun run --watch src/index.ts",
    "worker:analysis": "bun run --watch src/worker/analysis.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "push" : "drizzle-kit push",
