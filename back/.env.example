# ---------------------------------------------------------------------------
# Backend environment
#
# Copy to `back/.env` and fill in. Keep that file at mode 600 and out of git.
#
#   cp .env.example .env && chmod 600 .env
#
# Values marked "set by PM2" are supplied by ecosystem.config.cjs and do not
# belong here. Bun never overwrites a variable that already exists in
# process.env, so PM2's values win over this file.
# ---------------------------------------------------------------------------


# --- Database ---------------------------------------------------------------
# Required. The API and the migrations both refuse to start without it.
# Production: bind to loopback and keep the port closed to the internet.
# DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/gene_pilot"


# --- Object storage (MinIO / MinIO AIStor) ---------------------------------
# Required for uploads, presigned URLs and the storage health check.
# S3_ENDPOINT="http://127.0.0.1:9000"
# S3_BUCKET="genepilot"
# S3_REGION="us-east-1"            # default: us-east-1
# S3_ACCESS_KEY_ID="replace-me"
# S3_SECRET_ACCESS_KEY="replace-me"
# S3_FORCE_PATH_STYLE="true"       # required by MinIO; "false" for real S3


# --- Queue (BullMQ over Redis) ---------------------------------------------
# Required by the analysis worker. Not needed if the API only points at a remote
# worker via QUEUE_ENQUEUE_URL below.
# REDIS_URL="redis://127.0.0.1:6379"

# Attempt budget per analysis job. A missing BIO_SERVICE_URL fails immediately
# without consuming these, because the executor throws an UnrecoverableError.
# QUEUE_ATTEMPTS="3"               # default: 3

# Simultaneous analyses. Set this to what the Bio Service and any external APIs
# can absorb, not to the core count. The worker is single-instance under PM2, so
# this is the only concurrency knob.
# WORKER_CONCURRENCY="2"           # default: 2

# Split deployment only: have the API enqueue over HTTP to a worker on another
# host instead of connecting to Redis itself. Leave unset for the single-VPS
# setup, and set QUEUE_SECRET if you use it.
# QUEUE_ENQUEUE_URL="https://worker.example.com"

# Required if ENQUEUE_PORT is set, so the enqueue endpoint can authenticate
# callers. Generate with: openssl rand -hex 64
# QUEUE_SECRET="replace-me"

# HTTP port for the worker's /enqueue endpoint. Unset by default, which keeps
# the worker from opening a second listener. Set both together or neither.
# ENQUEUE_PORT="4010"


# --- Bioinformatics service -------------------------------------------------
# The URL the worker POSTs /sequence/analyze to (Langflow or the FastAPI Bio
# Service). Without it every analysis fails with "no analysis executor is
# available yet" and nothing can complete.
#
# Must be an absolute http(s) URL. Any path, query or fragment is discarded, so
# write the origin only. A commented-out placeholder like
# `BIO_SERVICE_URL=   # langflow here` is a non-empty string that fails
# validation with a message naming the bad value, rather than being mistaken for
# "unset" and reported as missing.
# BIO_SERVICE_URL="http://127.0.0.1:8000"

# Per-request timeout for that call, in milliseconds.
# BIO_SERVICE_TIMEOUT_MS="60000"   # default: 60000


# --- Langflow ----------------------------------------------------------------
# Langflow runs the language model and produces the analysis. It is reached
# through the Main flow's webhook and authenticates with an x-api-key header.
#
# Verify the wiring with GET /health/dependencies before submitting an
# analysis. A wrong host, or a webhook node that is still an unconfigured
# placeholder, otherwise shows up only as an analysis that never finishes.
#
# LANGFLOW_URL="https://langflow.example.com"
# LANGFLOW_MAIN_FLOW_ID="00000000-0000-0000-0000-000000000000"

# Required by the webhook. Server-side only; never expose it to the browser.
# LANGFLOW_API_KEY="replace-me"


# --- Sessions and auth ------------------------------------------------------
# Required. Signs the session cookie. Generate with: openssl rand -base64 64
# AUTH_SECRET="replace-me"

# Session lifetime in seconds.
# SESSION_TTL_SECONDS="604800"     # default: 604800 (7 days)

# Password hashing cost. Raising it slows brute-force attacks and login.
# PBKDF2_ITERATIONS="210000"       # default: 210000


# --- CORS and cookies -------------------------------------------------------
# Comma-separated exact origins allowed to send the session cookie. No wildcard
# is possible: the browser rejects Access-Control-Allow-Origin: * on a
# credentialed request, and the cookie is the point. Empty means no
# cross-origin caller is allowed at all.
# CORS_ORIGINS="http://localhost:3000"

# Must match how the frontend relates to this API:
#   "lax"  same-site subdomains (app.example.com + api.example.com)
#   "none" an unrelated site, which also forces the Secure flag
# If the browser silently drops the session cookie, check this first.
#
# A page on `localhost:3000` and an API on `127.0.0.1:4000` count as two
# different sites to a browser, so "lax" drops the cookie and sign-in looks
# broken. Keep the hostname identical on both sides.
# COOKIE_SAME_SITE="lax"           # default: lax


# --- Rate limiting ----------------------------------------------------------
# Fixed-window counters in Redis, shared by every API process so the limit is the
# configured one rather than that times the number of instances. The limiter
# fails closed: if Redis is unreachable these endpoints return 503
# RATE_LIMIT_UNAVAILABLE rather than letting traffic through unchecked.
#
# Per address, because there is no user yet:
# RATE_LIMIT_AUTH_LOGIN="10"              # default: 10 per 15 minutes
# RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS="900"
# RATE_LIMIT_AUTH_REGISTER="5"            # default: 5 per hour
# RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS="3600"
#
# Per authenticated user, for endpoints that create rows or queue jobs:
# RATE_LIMIT_ANALYSIS_QUEUE="30"          # default: 30 per hour
# RATE_LIMIT_ANALYSIS_QUEUE_WINDOW_SECONDS="3600"
# RATE_LIMIT_STORAGE_PRESIGN="60"         # default: 60 per hour
# RATE_LIMIT_STORAGE_PRESIGN_WINDOW_SECONDS="3600"
# RATE_LIMIT_STORAGE_UPLOAD="30"          # default: 30 per hour
# RATE_LIMIT_STORAGE_UPLOAD_WINDOW_SECONDS="3600"
# RATE_LIMIT_STORAGE_MUTATE="60"          # default: 60 per hour
# RATE_LIMIT_STORAGE_MUTATE_WINDOW_SECONDS="3600"
#
# Set any limit to 0 to disable that one rule.
#
# Header carrying the real client address, used solely as a rate-limit bucket
# key — never as an identity. The API binds to loopback behind a tunnel, so
# cloudflared rewrites this and no other process can reach it to forge it.
# Required by the login and register rules: without it those endpoints return 503
# rather than sharing one bucket across every caller.
# TRUSTED_IP_HEADER="cf-connecting-ip"
#
# Accept the shared bucket when the header is absent. Convenient locally,
# wrong in production, where one noisy client would throttle everyone else.
# RATE_LIMIT_FALLBACK_TO_UNKNOWN="0"      # default: 0 (refuse)


# --- Analysis types ---------------------------------------------------------
# The closed set POST /analyses accepts. An unrecognised type is a 422 rather
# than a queue job, so this value is the only thing that reaches the Bio Service.
# Must match what your executor implements; an empty or malformed value falls
# back to the built-in defaults rather than rejecting everything.
# ANALYSIS_ALLOWED_TYPES="gc_content,at_content,composition,orfs,translate,reverse_complement,blast,genbank_record"


# --- Runtime (set by PM2) ---------------------------------------------------
# NODE_ENV, DEPLOY_RUNTIME, HOST and PORT all come from ecosystem.config.cjs.
# Leave them commented here.
#
# DEPLOY_RUNTIME=vps or NODE_ENV=production marks a hosted runtime, which turns
# off the dev-auth shortcut and forces Secure cookies. Both must be absent
# locally, or the API hands out insecure cookies and a fake login.
# NODE_ENV="production"
# DEPLOY_RUNTIME="vps"
# HOST="127.0.0.1"                 # loopback only; cloudflared publishes it
# PORT="4000"

# Local development only: re-enable the no-password dev login. Ignored on a
# hosted runtime unless this is explicitly "true".
# ALLOW_DEV_AUTH="true"
# DEV_USER_EMAIL="developer@local.test"


# --- Tests only -------------------------------------------------------------
# Integration tests run against an already-running API and never truncate shared
# tables, so point this at a throwaway instance.
# TEST_API_URL="http://127.0.0.1:4000"
