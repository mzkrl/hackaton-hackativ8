# ---------------------------------------------------------------------------
# Backend environment
#
# Copy to `back/.env` and fill in. Keep that file at mode 600 and out of git.
#
#   cp .env.example .env && chmod 600 .env
#
# Values marked "set by PM2" are supplied by ecosystem.config.cjs and do not
# belong here. Bun never overwrites a variable that already exists in
# process.env, so PM2's values win over this file.
# ---------------------------------------------------------------------------


# --- Database ---------------------------------------------------------------
# Required. The API and the migrations both refuse to start without it.
# Production: bind to loopback and keep the port closed to the internet.
# DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/gene_pilot"


# --- Object storage (MinIO / MinIO AIStor) ---------------------------------
# Required for uploads, presigned URLs and the storage health check.
# S3_ENDPOINT="http://127.0.0.1:9000"
# S3_BUCKET="genepilot"
# S3_REGION="us-east-1"            # default: us-east-1
# S3_ACCESS_KEY_ID="replace-me"
# S3_SECRET_ACCESS_KEY="replace-me"
# S3_FORCE_PATH_STYLE="true"       # required by MinIO; "false" for real S3


# --- Queue (BullMQ over Redis) ---------------------------------------------
# Required by the analysis worker. Not needed if the API only points at a remote
# worker via QUEUE_ENQUEUE_URL below.
# REDIS_URL="redis://127.0.0.1:6379"

# Attempt budget per analysis job. A missing BIO_SERVICE_URL fails immediately
# without consuming these, because the executor throws an UnrecoverableError.
# QUEUE_ATTEMPTS="3"               # default: 3

# Simultaneous analyses. Set this to what the Bio Service and any external APIs
# can absorb, not to the core count. The worker is single-instance under PM2, so
# this is the only concurrency knob.
# WORKER_CONCURRENCY="2"           # default: 2

# How long one run may hold a worker slot before the worker stops waiting and
# hands the rest of the wait to a delayed re-check job. The slot is the scarce
# resource: with concurrency 2, a run that sits for ten minutes blocks a quarter
# of the queue for that whole time. 30s is long enough for a healthy executor
# call and short enough that a slow one costs one Redis round trip per interval
# instead of a locked slot.
# WORKER_JOB_TIMEOUT_MS="30000"     # default: 30000

# Delay between re-check jobs. Long enough that a merely-slow run has a chance to
# land before the next poll, short enough that a user watching the board is not
# left staring at "processing".
# WORKER_RECHECK_DELAY_MS="30000"   # default: 30000

# Upper bound on re-checks, so a run that never lands cannot poll forever. The
# bound is on re-checks, not elapsed time: ten re-checks at 30s is roughly five
# minutes before the run is failed, longer than any executor call should take.
# WORKER_MAX_RECHECKS="10"          # default: 10

# Split deployment only: have the API enqueue over HTTP to a worker on another
# host instead of connecting to Redis itself. Leave unset for the single-VPS
# setup, and set QUEUE_SECRET if you use it.
# QUEUE_ENQUEUE_URL="https://worker.example.com"

# Required if ENQUEUE_PORT is set, so the enqueue endpoint can authenticate
# callers. Generate with: openssl rand -hex 64
# QUEUE_SECRET="replace-me"

# HTTP port for the worker's /enqueue endpoint. Unset by default, which keeps
# the worker from opening a second listener. Set both together or neither.
# ENQUEUE_PORT="4010"


# --- Bioinformatics service (fallback executor) ------------------------------
# The FastAPI "Sequence Analysis Service". The worker POSTs to <URL>/analyze as a
# fallback when Langflow is disabled or fails.
#
# Endpoint: POST /analyze  (there is NO /sequence/analyze -- that path 404s)
# Body:     { "sequence": "<raw sequence text>", "tools": ["gc_content"] }
#           `sequence` and `tools` are both REQUIRED; `tools` takes analysis-type
#           names, so one call carries one or more of the allowed types.
# Response: { "status": ..., "file_metadata": ..., "results": { ... } }
#
# The executor sends the raw sequence text read from the sequences table, not an
# id -- the service has no access to this database.
#
# Must be an absolute http(s) URL. Any path, query or fragment is discarded, so
# write the origin only. A commented-out placeholder like
# `BIO_SERVICE_URL=   # langflow here` is a non-empty string that fails
# validation with a message naming the bad value, rather than being mistaken for
# "unset" and reported as missing.
#
# This service is unauthenticated by design and lives on the VPS, so do not
# publish its port. Reach it over Tailscale or loopback, never a public interface.
# BIO_SERVICE_URL="http://127.0.0.1:8000"

# Per-request timeout for that call, in milliseconds.
# BIO_SERVICE_TIMEOUT_MS="60000"   # default: 60000

# This service takes no auth, so there is no key variable here. Reach it over
# Tailscale or loopback and never publish its port.


# --- Langflow (primary executor) ---------------------------------------------
# Langflow runs the language model and produces the analysis. The worker POSTs to
# <URL>/api/v1/webhook/<flow id> with an x-api-key header.
#
# Verified against Langflow 1.12.3 (OpenAPI, 85 paths):
#   * There is NO async run API. /api/v1/run, /run/advanced and /webhook are all
#     synchronous, and RunResponse is only { outputs, session_id } -- no job_id and
#     no run-status endpoint. Polling must therefore target THIS API's own
#     GET /analyses/:id/status, never Langflow.
#   * The Main flow (362f3676-...) has no output node, so its webhook returns
#     nothing persistable. The Sequence flow (b8d7ed50-...) has a ChatOutput, so
#     LANGFLOW_MAIN_FLOW_ID below points at the Sequence flow.
#     Verified end to end: the webhook accepted a request and the flow ran, so
#     both the flow id and the API key are live. Re-point this only if the flow
#     owner confirms a different entrypoint.
#
# Verify the wiring with GET /health/dependencies before submitting an analysis.
# LANGFLOW_URL="https://langflow.example.com"
# LANGFLOW_MAIN_FLOW_ID="00000000-0000-0000-0000-000000000000"

# Required by the webhook. Server-side only; never expose it to the browser.
# LANGFLOW_API_KEY="replace-me"

# Per-request timeout. Langflow holds the request open for the whole model call,
# so this is the run budget, not a network timeout -- set it above the flow's own
# node timeout so the flow's error is the one that surfaces.
# LANGFLOW_TIMEOUT_MS="120000"      # default: 120000

# Kill switch. When "false" the worker goes straight to the Bio Service fallback
# and never touches Langflow, so a broken flow can be taken out of the path
# without a deploy.
# LANGFLOW_ENABLED="true"           # default: true
#
# GET /health/dependencies only probes Langflow's cheap /health_check by default.
# Setting this to "1" additionally POSTs to the real webhook, which is the only
# check that proves the flow id and API key actually work -- a 401 here is the
# failure that /health_check happily reports as healthy.
#
# It is off by default because a webhook POST RUNS THE FLOW: it invokes the
# model and spends tokens. Never point an uptime monitor at it while this is on.
# Turn it on, run `bun run scripts/check-dependencies.ts` once by hand, then turn
# it back off.
# LANGFLOW_WEBHOOK_PROBE="1"


# --- Sessions and auth ------------------------------------------------------
# Required. Signs the session cookie. Generate with: openssl rand -base64 64
# AUTH_SECRET="replace-me"

# Session lifetime in seconds.
# SESSION_TTL_SECONDS="604800"     # default: 604800 (7 days)

# Password hashing cost. Raising it slows brute-force attacks and login.
# PBKDF2_ITERATIONS="210000"       # default: 210000


# --- CORS and cookies -------------------------------------------------------
# Comma-separated exact origins allowed to send the session cookie. No wildcard
# is possible: the browser rejects Access-Control-Allow-Origin: * on a
# credentialed request, and the cookie is the point. Empty means no
# cross-origin caller is allowed at all.
# CORS_ORIGINS="http://localhost:3000"
#
# Comma-separated, exact-match allowlist. There is no wildcard: an origin that is
# not listed gets no `access-control-allow-origin` at all, which is the correct
# answer and is exactly what the "does not reflect an origin that is not
# allowlisted" test asserts.
#
# List your real frontend origins and nothing else. Do not add an origin just to
# satisfy a test: CORS is verified against an app that the test builds with its
# own allowlist (see `__tests__/lib/cors.test.ts`), so no test ever needs an entry
# here. A test that fails on a null header means that origin is not allowed,
# which is the allowlist doing its job -- not a missing line.
#
# PRODUCTION: replace this list with the real frontend origins -- the Vercel
# deployment URL and the Cloudflare Pages hostname. A wrong value here fails
# quietly: the browser just drops the session cookie and sign-in looks broken.

# Must match how the frontend relates to this API:
#   "lax"  same-site subdomains (app.example.com + api.example.com)
#   "none" an unrelated site, which also forces the Secure flag
# If the browser silently drops the session cookie, check this first.
#
# A page on `localhost:3000` and an API on `127.0.0.1:4000` count as two
# different sites to a browser, so "lax" drops the cookie and sign-in looks
# broken. Keep the hostname identical on both sides.
# COOKIE_SAME_SITE="lax"           # default: lax


# --- Rate limiting ----------------------------------------------------------
# Fixed-window counters in Redis, shared by every API process so the limit is the
# configured one rather than that times the number of instances. The limiter
# fails closed: if Redis is unreachable these endpoints return 503
# RATE_LIMIT_UNAVAILABLE rather than letting traffic through unchecked.
#
# Per address, because there is no user yet:
# RATE_LIMIT_AUTH_LOGIN="10"              # default: 10 per 15 minutes
# RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS="900"
# RATE_LIMIT_AUTH_REGISTER="5"            # default: 5 per hour
# RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS="3600"
#
# Also per address: a guest session has to be created before there is a
# principal to key on, and each one costs a database row plus a cookie.
# RATE_LIMIT_AUTH_GUEST="10"             # default: 10 per hour
# RATE_LIMIT_AUTH_GUEST_WINDOW_SECONDS="3600"
#
# `0` disables a rule, which is what the API under test needs when running the
# integration suite: `bun test __tests__/api/` registers more accounts and guest
# sessions from one address than any of the budgets above allow, so the limiter
# fails the suite instead of the suite testing the limiter. Start the API with
# RATE_LIMIT_AUTH_REGISTER=0 RATE_LIMIT_AUTH_GUEST=0 (and RATE_LIMIT_AUTH_LOGIN=0
# for the login suites) to run it.
#
# Note the flip side: with these budgets off, nothing in the suite exercises the
# limiter. `consume`/`enforce` are currently only covered by
# `scripts/check-poll-budget.ts` against real Redis, not by `bun test`. The
# fixed-window and fail-closed behaviour deserves unit tests of its own; until
# then, do not read a green suite as evidence that these limits work.
#
# Per authenticated user, for endpoints that create rows or queue jobs:
# RATE_LIMIT_ANALYSIS_QUEUE="30"          # default: 30 per hour
# RATE_LIMIT_ANALYSIS_QUEUE_WINDOW_SECONDS="3600"
#
# The frontend polls GET /analyses/:id/status about every 2 seconds while an
# analysis runs, so this needs a separate, much higher budget than the endpoints
# that create work -- otherwise a normal run trips the submit limit. Keyed per
# user, so one noisy poller cannot starve the others.
#
# The window is a MINUTE, not an hour, and the budget is sized for the dashboard:
# 30 polls/min/analysis x ~5 concurrent runs = 150, so 240 leaves headroom. An
# earlier draft proposed 600 per hour, which is only 10/min -- less than a single
# analysis needs, so it would have broken normal polling outright.
# RATE_LIMIT_ANALYSIS_STATUS_POLL="240"          # default: 240 per minute
# RATE_LIMIT_ANALYSIS_STATUS_POLL_WINDOW_SECONDS="60"
#
# This limit is only the backstop. Repeated polls are normally answered by a
# short-TTL Redis cache (`src/lib/analysis-status-cache.ts`) without touching
# Postgres, so the flood defence is the cache and this is the ceiling.
# RATE_LIMIT_STORAGE_PRESIGN="60"          # default: 60 per hour
# RATE_LIMIT_STORAGE_PRESIGN_WINDOW_SECONDS="3600"
# RATE_LIMIT_STORAGE_UPLOAD="30"          # default: 30 per hour
# RATE_LIMIT_STORAGE_UPLOAD_WINDOW_SECONDS="3600"
# RATE_LIMIT_STORAGE_MUTATE="60"          # default: 60 per hour
# RATE_LIMIT_STORAGE_MUTATE_WINDOW_SECONDS="3600"
#
# Set any limit to 0 to disable that one rule.
#
# Header carrying the real client address, used solely as a rate-limit bucket
# key — never as an identity. The API binds to loopback behind a tunnel, so
# cloudflared rewrites this and no other process can reach it to forge it.
# Required by the login and register rules: without it those endpoints return 503
# rather than sharing one bucket across every caller.
# TRUSTED_IP_HEADER="cf-connecting-ip"
#
# Accept the shared bucket when the header is absent. Convenient locally,
# wrong in production, where one noisy client would throttle everyone else.
# RATE_LIMIT_FALLBACK_TO_UNKNOWN="0"      # default: 0 (refuse)


# --- Analysis types ---------------------------------------------------------
# The closed set POST /analyses accepts. An unrecognised type is a 422 rather
# than a queue job, so this value is the only thing that reaches the Bio Service.
# Must match what your executor implements; an empty or malformed value falls
# back to the built-in defaults rather than rejecting everything.
# ANALYSIS_ALLOWED_TYPES="gc_content,at_content,composition,orfs,translate,reverse_complement,blast,genbank_record"


# --- Runtime (set by PM2) ---------------------------------------------------
# NODE_ENV, DEPLOY_RUNTIME, HOST and PORT all come from ecosystem.config.cjs.
# Leave them commented here.
#
# DEPLOY_RUNTIME=vps or NODE_ENV=production marks a hosted runtime, which turns
# off the dev-auth shortcut and forces Secure cookies. Both must be absent
# locally, or the API hands out insecure cookies and a fake login.
# NODE_ENV="production"
# DEPLOY_RUNTIME="vps"
# HOST="127.0.0.1"                 # loopback only; cloudflared publishes it
# PORT="4000"

# Local development only: re-enable the no-password dev login. Ignored on a
# hosted runtime unless this is explicitly "true".
# ALLOW_DEV_AUTH="true"
# DEV_USER_EMAIL="developer@local.test"


# --- Tests only -------------------------------------------------------------
# Integration tests run against an already-running API and never truncate shared
# tables, so point this at a throwaway instance.
# TEST_API_URL="http://127.0.0.1:4000"
